#
# Import the Training Content Catalog
#
$contentCatalog = trainingContentCatalog
$lang = en

# Content catalog for CMS contents
INSERT_UPDATE ContentCatalog; id[unique = true]; name[lang = $lang]
                            ; $contentCatalog  ; "Training Content Catalog"

# Catalog versions for content catalogs
INSERT_UPDATE CatalogVersion; catalog(id)[unique = true]; version[unique = true]; active; languages(isoCode)
                            ; $contentCatalog           ; Staged                ; false ; $lang
                            ; $contentCatalog           ; Online                ; true  ; $lang

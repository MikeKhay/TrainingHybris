$contentCatalog = electronicsContentCatalog
$contentCV = catalogVersion(CatalogVersion.catalog(Catalog.id[default = $contentCatalog]), CatalogVersion.version[default = Staged])[default = $contentCatalog:Staged]
$lang = en
$medias = medias(code, $contentCV);
$mediaContainer = media(qualifier, $contentCV)[lang = $lang];
$siteResource = jar:org.training.initialdata.constants.TrainingInitialDataConstants&/traininginitialdata/import/$contentCatalog



# Media Content
INSERT_UPDATE Media; mediaFormat(qualifier); $contentCV[unique = true]; code[unique = true]                       ; @media[translator = de.hybris.platform.impex.jalo.media.MediaDataTranslator][forceWrite = true]; mime[default = 'image/jpeg']; realfilename                              ; folder(qualifier)[default = 'images']; altText
                   ; widescreen            ;                          ; Elec_1400x80_CartDiscount_EN_01_1400W.png ; $siteResource/images/Elec_1400x80_CartDiscount_EN_01_1400W.png                                 ;                             ; Elec_1400x80_CartDiscount_EN_01_1400W.png ;                                      ; "10% discount if total price is more than $1000 for widescreen"
                   ; mobile                ;                          ; Elec_480x118_CartDiscount_EN_01_480W.png  ; $siteResource/images/Elec_480x118_CartDiscount_EN_01_480W.png                                  ;                             ; Elec_480x118_CartDiscount_EN_01_480W.png  ;                                      ; "40% discount if total price is more than $1000 for mobile"
                   ; tablet                ;                          ; Elec_770x80_CartDiscount_EN_01_770W.png   ; $siteResource/images/Elec_770x80_CartDiscount_EN_01_770W.png                                   ;                             ; Elec_770x80_CartDiscount_EN_01_770W.png   ;                                      ; "30% discount if total price is more than $1000 for tablet"
                   ; desktop               ;                          ; Elec_960x80_CartDiscount_EN_01_960W.png   ; $siteResource/images/Elec_960x80_CartDiscount_EN_01_960W.png                                   ;                             ; Elec_960x80_CartDiscount_EN_01_960W.png   ;                                      ; "20% discount if total price is more than $1000 for desktop"


INSERT_UPDATE MediaContainer; qualifier[unique = true]     ; $medias                                                                                                                                                            ; $contentCV[unique = true]
                            ; electronics-cart-discount-en ; Elec_480x118_CartDiscount_EN_01_480W.png,Elec_770x80_CartDiscount_EN_01_770W.png,Elec_960x80_CartDiscount_EN_01_960W.png,Elec_1400x80_CartDiscount_EN_01_1400W.png ;

INSERT_UPDATE SimpleResponsiveBannerComponent; $contentCV[unique = true]; uid[unique = true]                         ; name                                           ; $mediaContainer              ; urlLink                                                       ; &componentRef
                                             ;                          ; ElectronicsCartpageDiscountBannerComponent ; Electronics Cartpage Discount Banner Component ; electronics-cart-discount-en ; /Open-Catalogue/Cameras/Camera-Accessories-%26-Supplies/c/585 ; ElectronicsCartpageDiscountBannerComponent

INSERT_UPDATE ContentSlot; $contentCV[unique = true]; uid[unique = true]  ; name                   ; active; cmsComponents(uid, $contentCV)
                         ;                          ; TopContent-cartPage ; Top Slot for Cart Page ; true  ; ElectronicsCartpageDiscountBannerComponent,CartComponent